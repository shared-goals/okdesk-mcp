# Okdesk account URL, without /api/v1.
OKDESK_DOMAIN=https://your-account.okdesk.ru

# Okdesk API token. Keep this file local and never commit it.
OKDESK_API_TOKEN=replace-with-your-token

# Shared report parameters. Edit these and rerun the relevant consumer.
CRITICAL_HOURS=24
UNANSWERED_HOURS=48
PAGE_SIZE=50
COMPANY_CATEGORY_ID=13
